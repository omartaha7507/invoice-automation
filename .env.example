# Copy this file to .env and fill in your key. Never commit .env.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Stay under the free-tier limit
LLM_REQUESTS_PER_MINUTE=4
LLM_MAX_RETRIES=4

# Remove IBANs, emails and phone numbers before text is sent to the LLM
REDACT_PII=true
# false = every warning goes to a human; true = only errors do
AUTO_APPROVE_WITH_WARNINGS=false

# Where approved invoices go: "mock" (JSON-lines outbox in data/erp_outbox) or "webhook"
ERP_MODE=mock
ERP_WEBHOOK_URL=

# Purchase orders to match invoices against (the demo set matches the sample invoices)
PURCHASE_ORDERS_CSV=evaluation/dataset/purchase_orders.csv

# Optional: collect invoices from an email inbox (used by `python -m app.watcher`)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Defaults to SQLite in data/. Docker Compose sets PostgreSQL.
# DATABASE_URL=postgresql+psycopg://invoices:invoices@localhost:5432/invoices
